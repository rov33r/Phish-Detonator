# Vultr Serverless Inference
VULTR_INFERENCE_KEY=
PD_MODEL=
PD_MODEL_FALLBACK=
PD_VISION_MODEL=
# Candidates (SPEC 6.5): glm-5.3, deepseek-v4.1-flash-1017, qwen3.8-flash-next (vision)
# Approval gate before submit (SPEC 6.6): auto, or manual (stretch)
PD_APPROVAL_MODE=auto

# Vultr account API (high-risk mode only)
VULTR_API_KEY=

# Vultr Object Storage
PD_S3_ENDPOINT=
PD_S3_KEY=
PD_S3_SECRET=
PD_S3_BUCKET=phishdet-evidence

# Runtime: runsc on the VM, runc on a laptop without gVisor
PD_RUNTIME=runsc
PD_PUBLIC_IP_DASHED=
PD_MAX_STEPS=15

# Active browser investigations: enable only for controlled, owner-authorized fixture hosts.
# Hosts are exact-match allowlisted; other pasted URLs use passive screenshot capture.
PD_FEATURE_ORCHESTRATOR=0
# Owned fixture hosts are always active in orchestrator mode; add more hosts, or * for every link.
PD_ACTIVE_SCAN_HOSTS=

# Investigator budget per scan (SPEC 6A.2)
PD_INVESTIGATOR_MAX_SANDBOXES=5
PD_INVESTIGATOR_MAX_SECONDS=240

# Public URL protection (SPEC 10)
PD_MAX_SCANS=2
PD_MAX_SANDBOXES=4
PD_RATE_LIMIT_PER_IP=20

# Signed reports (SPEC 11A.3): host-only Ed25519 key, created on first start
PD_REPORT_KEY_PATH=/var/lib/phishdet/report.key

# Demo safety net (SPEC 11A.2): preset=pinned scan id
PD_DEMO_SCANS=
